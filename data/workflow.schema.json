{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Build Workflow",
  "type": "object",
  "required": [
    "title",
    "version",
    "stages"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "gate"
        ]
      }
    }
  }
}
